//Policy Bundle API - versioned sets of policy files for external policy
//engines (OPA/Rego) that ZMS stores and signs and ZTS serves.
include "Names.tdl";
include "PolicyBundle.tdl";

//List policy bundles provisioned in this domain.
resource PolicyBundleList GET "/domain/{domainName}/bundle" {
    DomainName domainName; //name of the domain
    authenticate;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Get all policy bundles (including their files) provisioned in this domain.
resource PolicyBundles GET "/domain/{domainName}/bundles?includeNonActive={includeNonActive}" {
    DomainName domainName; //name of the domain
    Bool includeNonActive (optional, default=false); //include non-active bundle versions
    authorize("zms.getbundle", "{domainName}:bundle.*");
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Read the active version of the specified policy bundle.
resource PolicyBundle GET "/domain/{domainName}/bundle/{bundleName}" {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    authorize("zms.getbundle", "{domainName}:bundle.{bundleName}");
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Create or update the specified policy bundle. If the version attribute is
//not specified, the active version of the bundle is created/updated. If the
//version is specified and the bundle already exists, the given version is
//updated or created as a non-active version.
resource PolicyBundle PUT "/domain/{domainName}/bundle/{bundleName}" {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    String auditRef (header="Y-Audit-Ref"); //Audit param required(not empty) if domain auditEnabled is true.
    Bool returnObj (optional, default=false, header="Athenz-Return-Object"); //Return object param updated object back.
    PolicyBundle bundle; //PolicyBundle object to be added or updated in the domain
    authorize("zms.updatebundle", "{domainName}:bundle.{bundleName}");
    expected NO_CONTENT, OK;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError CONFLICT;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Delete the specified policy bundle including all of its versions. Upon
//successful completion of this delete request, the server will return
//NO_CONTENT status code without any data (no object will be returned).
resource PolicyBundle DELETE "/domain/{domainName}/bundle/{bundleName}" {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    String auditRef (header="Y-Audit-Ref"); //Audit param required(not empty) if domain auditEnabled is true.
    authorize("zms.deletebundle", "{domainName}:bundle.{bundleName}");
    expected NO_CONTENT;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError CONFLICT;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Add or replace a single file in the active version of the specified policy bundle.
resource PolicyBundleFile PUT "/domain/{domainName}/bundle/{bundleName}/file" (name=putPolicyBundleFile) {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    String auditRef (header="Y-Audit-Ref"); //Audit param required(not empty) if domain auditEnabled is true.
    PolicyBundleFile file; //file to be added or replaced in the bundle
    authorize("zms.updatebundle", "{domainName}:bundle.{bundleName}");
    expected NO_CONTENT;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError CONFLICT;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Delete a single file from the active version of the specified policy bundle.
resource PolicyBundle DELETE "/domain/{domainName}/bundle/{bundleName}/file?path={path}" (name=deletePolicyBundleFile) {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    String path (optional); //path of the file to be removed from the bundle, relative to the bundle root
    String auditRef (header="Y-Audit-Ref"); //Audit param required(not empty) if domain auditEnabled is true.
    authorize("zms.updatebundle", "{domainName}:bundle.{bundleName}");
    expected NO_CONTENT;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError CONFLICT;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//List the versions of the specified policy bundle.
resource PolicyBundleList GET "/domain/{domainName}/bundle/{bundleName}/version" (name=getPolicyBundleVersionList) {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    authenticate;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Get the specified policy bundle version.
resource PolicyBundle GET "/domain/{domainName}/bundle/{bundleName}/version/{version}" (name=getPolicyBundleVersion) {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    SimpleName version; //name of the version to be retrieved
    authorize("zms.getbundle", "{domainName}:bundle.{bundleName}");
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Create a new non-active policy bundle version based on the given source version
resource PolicyBundle PUT "/domain/{domainName}/bundle/{bundleName}/version/create" (name=putPolicyBundleVersion) {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    PolicyBundleOptions bundleOptions; //name of the new version and the source version to copy from
    String auditRef (header="Y-Audit-Ref"); //Audit param required(not empty) if domain auditEnabled is true.
    Bool returnObj (optional, default=false, header="Athenz-Return-Object"); //Return object param updated object back.
    authorize("zms.updatebundle", "{domainName}:bundle.{bundleName}");
    expected NO_CONTENT, OK;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError CONFLICT;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Mark the specified policy bundle version as active.
resource PolicyBundle PUT "/domain/{domainName}/bundle/{bundleName}/version/active" (name=setActivePolicyBundleVersion) {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    PolicyBundleOptions bundleOptions; //name of the version to be activated
    String auditRef (header="Y-Audit-Ref"); //Audit param required(not empty) if domain auditEnabled is true.
    authorize("zms.updatebundle", "{domainName}:bundle.{bundleName}");
    expected NO_CONTENT;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError CONFLICT;
        ResourceError TOO_MANY_REQUESTS;
    }
}

//Delete the specified non-active policy bundle version. Upon successful
//completion of this delete request, the server will return NO_CONTENT
//status code without any data (no object will be returned).
resource PolicyBundle DELETE "/domain/{domainName}/bundle/{bundleName}/version/{version}" (name=deletePolicyBundleVersion) {
    DomainName domainName; //name of the domain
    EntityName bundleName; //name of the bundle
    SimpleName version; //name of the version to be deleted
    String auditRef (header="Y-Audit-Ref"); //Audit param required(not empty) if domain auditEnabled is true.
    authorize("zms.deletebundle", "{domainName}:bundle.{bundleName}");
    expected NO_CONTENT;
    exceptions {
        ResourceError BAD_REQUEST;
        ResourceError NOT_FOUND;
        ResourceError FORBIDDEN;
        ResourceError UNAUTHORIZED;
        ResourceError CONFLICT;
        ResourceError TOO_MANY_REQUESTS;
    }
}
